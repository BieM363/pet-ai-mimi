# ========================================================
# PENGATURAN VIRTUAL PIXEL CAT AI DESKTOP PET
# ========================================================

# Masukkan Google Gemini API Key Anda dari Google AI Studio (Gratis):
# Dapatkan di: https://aistudio.google.com/
# Anda juga bisa mengaturnya langsung dari aplikasi lewat Klik Kanan -> "Atur Gemini API Key"
GEMINI_API_KEY=your_gemini_api_key_here

# Model Gemini yang digunakan (gemini-1.5-flash untuk respon cepat & mendukung Google Search Grounding)
GEMINI_MODEL=gemini-1.5-flash

# Nama kucing virtual (default: Mimi)
PET_NAME=Mimi

# Aktifkan suara Text-to-Speech (true / false)
TTS_ENABLED=true

# Kecepatan bicara TTS (default: 175)
TTS_RATE=175

# ========================================================
# PENGATURAN DISCORD RICH PRESENCE (ACTIVITY PROFILE)
# ========================================================
# Aktifkan status profil Discord "Playing Mimi Agent Pet" (true / false)
DISCORD_RPC_ENABLED=true

# Discord Application Client ID:
# Dapatkan gratis di https://discord.com/developers/applications
# Buat aplikasi bernama "Mimi Agent Pet", lalu salin Application ID ke sini:
DISCORD_CLIENT_ID=
